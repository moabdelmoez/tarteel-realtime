R2_ENDPOINT_URL=https://bb8b1b9ffb067e41f5657c9f1400c42b.r2.cloudflarestorage.com
R2_BUCKET=tarteel-realtime
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# LiveKit Cloud. Leave these blank to use local `livekit-server --dev`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TARTEEL_LIVEKIT_ROOM=tarteel-recitation
TARTEEL_LIVEKIT_TOKEN_TTL_MINUTES=60
TARTEEL_LIVEKIT_WORKER_IDENTITY=tarteel-backend-worker

# Real ASR input safety. Applied after WebSocket/LiveKit frame decode and before
# the rolling Whisper buffer is built.
TARTEEL_WHISPER_BACKEND=transformers
TARTEEL_FASTER_WHISPER_COMPUTE_TYPE=
TARTEEL_ASR_MIN_SPEECH_RMS=400
TARTEEL_ASR_MIN_FRAME_RMS=150
